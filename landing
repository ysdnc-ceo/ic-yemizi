          </div>
          <div>
            <label class="lb" for="userPhone">연락처 *</label>
            <input class="inp" type="tel" id="userPhone" required placeholder="010-1234-5678" />
          </div>
          <div class="f-full">
            <label class="lb" for="userType">관심 평형</label>
            <select class="inp" id="userType">
              <option value="84A">84㎡ A 타입</option>
